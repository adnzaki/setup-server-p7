server {
    listen 443 ssl;
    server_name office.sdnpengasinan7.sch.id;

    ssl_certificate     /etc/letsencrypt/live/office.sdnpengasinan7.sch.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/office.sdnpengasinan7.sch.id/privkey.pem;

    location / {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
